    "express": "4.21.2",
    "express-validator": "6.15.0",
    "firebase-admin": "^12.7.0",
    "helmet": "6.2.0",
    "jsonwebtoken": "9.0.2",
    "mammoth": "1.11.0",
    "mongoose": "7.8.7",
    "morgan": "1.10.0",
    "multer": "^1.4.5-lts.2",
